# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# База данных (значение ниже подходит для docker-compose.yml из корня проекта)
DATABASE_URL="postgresql://literacy:literacy@localhost:5432/literacy"

# ОБЯЗАТЕЛЬНО свой длинный случайный секрет, например: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Часовой пояс для подсчёта «дней подряд» (Казахстан = 5)
STREAK_UTC_OFFSET=5

# Админ, который создаётся командой `npm run prisma:seed`.
# В production без ADMIN_PASSWORD seed не запустится.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# SEED_DEMO=false — не создавать демо-родителей и детей (для чистой базы)
# SEED_DEMO=false
